# =========================================
# .env.example — copy thành .env và điền giá trị thật
# KHÔNG BAO GIỜ commit file .env thật lên Git
# =========================================

# --- Server ---
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_ai

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- AI ---
DEEPSEEK_API_KEY=
AI_MODEL_DEFAULT=deepseek-chat
AI_MODEL_REASONING=deepseek-reasoner
AI_MAX_TOKENS_PER_REQUEST=4096
AI_MAX_STEPS_PER_SESSION=15

# --- External APIs (Nhóm 3) ---
GOOGLE_PLACES_API_KEY=
MAPBOX_ACCESS_TOKEN=
OPENWEATHER_API_KEY=
EXCHANGE_RATE_API_KEY=

# --- Email (Nhóm 5) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Travel AI <no-reply@travel-ai.com>"

# --- Rate limit ---
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
